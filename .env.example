APP_NAME="Fontoura Desenvolvimento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8132
APP_BASE=/

# ----------------------------------------------------------------------
# Portas dos containers Docker (parametrizadas para evitar conflito local)
# ----------------------------------------------------------------------
APP_PORT=8132
WEB_PORT=8092
DB_FORWARD_PORT=3322
VITE_PORT=5185

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fontoura_desenvolvimento
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# SEO — metadados do site (usados em meta tags, Open Graph, Twitter e JSON-LD)
# Todos são opcionais: quando vazios, o config/seo.php usa valores padrão.
# ----------------------------------------------------------------------

# URL pública do site (usada em canonical, og:url e sitemap.xml).
# Em produção, use o domínio real (ex.: https://fontouradesenvolvimento.com.br).
# Se vazio, cai no APP_URL.
SEO_SITE_URL=

# Imagem de compartilhamento social (og:image / twitter:image).
# Caminho relativo a /public (ex.: img/og-cover.png) ou URL absoluta.
# Recomendado: 1200x630px. Se vazio, usa o logo (img/fontoura-dragao.png).
SEO_OG_IMAGE=

# E-mail de contato exibido nos dados estruturados (JSON-LD).
SEO_CONTACT_EMAIL=

# Perfis em redes sociais (entram no "sameAs" do JSON-LD).
# Deixe vazio para omitir. O WhatsApp já tem um padrão no config.
SEO_WHATSAPP_URL=
SEO_LINKEDIN_URL=
SEO_INSTAGRAM_URL=
SEO_GITHUB_URL=

# Usuário do Twitter/X, sem o "@" (usado em twitter:site). Vazio = omitido.
SEO_TWITTER_HANDLE=
